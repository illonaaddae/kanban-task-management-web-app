# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Copy to .env and adjust. Only VITE_-prefixed variables reach the browser —
# never put a secret in here, it ships in the bundle.

VITE_APP_NAME=Kanban Task Management
VITE_APP_VERSION=1.0.0

# ─── API backend ────────────────────────────────────────────────────────────
# Base URL of the Express server in ./server (no trailing slash).
# Local:  http://localhost:5050
# Render: https://your-service.onrender.com
VITE_API_URL=http://localhost:5050

# Which auth implementation the app uses:
#   api       the Express backend in ./server  (default)
#   appwrite  the original Appwrite project    (legacy)
#   mock      in-memory, no network            (what the Vitest suite forces)
VITE_AUTH_PROVIDER=api

# ─── Appwrite (legacy — only needed when VITE_AUTH_PROVIDER=appwrite) ───────
# VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=
# VITE_APPWRITE_DATABASE_ID=
# VITE_APPWRITE_BOARDS_COLLECTION_ID=
# VITE_APPWRITE_TASKS_COLLECTION_ID=
# VITE_APPWRITE_BUCKET_ID=

# Superseded by VITE_AUTH_PROVIDER. Still honoured when that is unset, so an
# older .env keeps working: VITE_USE_APPWRITE=true behaves like
# VITE_AUTH_PROVIDER=appwrite.
# VITE_USE_APPWRITE=false
