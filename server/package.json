{
  "name": "kanban-server",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Express + MongoDB API for the Kanban task management app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit",
    "test:parallel": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "seed": "tsx src/seed/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.0",
    "openai": "^7.4.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "resend": "^6.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "mongodb-memory-server": "^10.2.4",
    "nodemon": "3.1.11",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
