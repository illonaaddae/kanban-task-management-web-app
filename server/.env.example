# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Avoid 5000 on macOS — Control Center's AirPlay Receiver holds it and answers
# every request with a bodyless 403 that looks like a CORS failure.
PORT=5050
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/kanban
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kanban?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/kanban

# ─── JWT ────────────────────────────────────────────────────────────────────
# Must be at least 32 characters and MUST differ from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-character-random-hex-string-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-me-with-a-different-64-character-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / redirects ───────────────────────────────────────────────────────
# Vite dev server locally; the Vercel URL in production.
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# Leave all three unset to run without Google sign-in — email/password auth
# still works. Set all three together; a partial config fails at startup on
# purpose, because a half-configured client only fails later at the redirect
# with an opaque Google error.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5050/auth/google/callback

# ─── Email / invitations (optional) ─────────────────────────────────────────
# Without RESEND_API_KEY, invitations are still created and their accept link is
# logged and returned to the inviting admin — the invite works, it just has to
# be delivered by hand. Set the key to actually send mail.
# Get one at https://resend.com/api-keys
# RESEND_API_KEY=re_...
#
# `onboarding@resend.dev` is Resend's shared sandbox sender: it needs no domain
# setup but only delivers to the address that owns the API key. Point this at a
# verified domain to reach anyone else.
EMAIL_FROM=Kanban <onboarding@resend.dev>
# How long an invitation link stays valid.
INVITATION_EXPIRES_DAYS=7
